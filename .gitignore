# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Hunter run output. Anything here is derived from whichever repository Hunter
# was pointed at, so it must never be committed. See the client-content guard
# in scripts/check_no_client_content.py
out/
report.json
.hunter/baseline.json

# The built documentation site.
#
# docs-html/ IS committed, so the site can be opened from any checkout without
# installing anything. That is a deliberate trade: 4 MB in the repository
# against documentation somebody actually reads. To stop committing it, add
# /docs-html/ below and delete the folder.
/site/
_built/

# Local scratch
scratch/
*.local.*

# macOS
.DS_Store

# Editor and agent session state
.claude/
.vscode/settings.json
